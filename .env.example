# Copy to .env for local development.
PORT=3000
DATABASE_PATH=./class-connect.db
# npm run hash-password -- <password>
LECTURER_PASSWORD_HASH=
LECTURER_NAME=Lecturer
# Any long random string; signs the Lecturer session cookie.
COOKIE_SECRET=
# Uploaded Transcripts, kept under their content hash.
FILES_DIR=./files
# openrouter (default) or fake (scripted replies, no requests spent).
LLM_ADAPTER=fake
OPENROUTER_API_KEY=
# Optional: comma-separated fallback list of model ids (defaults in src/server/config.ts).
# LLM_MODELS=
FAKE_LLM_DELAY_MS=1500
