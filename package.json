{
  "name": "class-connect",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/main.ts",
    "dev:client": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "backup": "node --env-file-if-exists=.env dist/server/backup.js",
    "deploy": "sh -c 'ssh wsl bash -s -- \"$@\" < scripts/deploy.sh' deploy",
    "check": "tsc --noEmit && eslint . && vitest run",
    "test": "vitest",
    "db:generate": "drizzle-kit generate",
    "hash-password": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@tanstack/react-query": "^5.108.4",
    "better-sqlite3": "^13.2.0",
    "dompurify": "^3.5.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.22",
    "marked": "^18.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
